# BrickBot Telegram – Environment Variables
# Copy this to .env and fill in your real values.

TELEGRAM_TOKEN=YOUR_BOT_TOKEN_HERE

# Optional: Discord webhook for admin alerts
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_id/your_token

# Optional: Admin user IDs (comma-separated)
ADMIN_IDS=

# Set this to 'true' when deploying on Render or similar cloud platforms
# to enable console-only logging.
RENDER=false
